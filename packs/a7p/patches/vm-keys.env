# a7p (Y09P_RV1106_V0): Home=102 沿用 A 系 gpio-keys（起机后从客机 event 设备核对）。
# model 绑定后 get_pcba_version 按 0x48d6e2 的映射表返回 Y09P_RV1106_V0，
# 固件自己会选 input-event-daemon_Y09.conf / rtl_hciattach hermesV1 分支。
MODEL='Rockchip RV1106 for Y09P V10 Board'
VM_KEY_DEVICE=gpio-keys
VM_KEY_BYPATH=gpio-keys
VM_KEY_CODES=102
HOME_CODE=102
VOL_DOWN_CODE=
VOL_UP_CODE=
