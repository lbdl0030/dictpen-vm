# x3s342 (Cherry-3566_V0): Home=115 on platform-adc-keys-event.
# 键码与 by-path 名取自固件 /usr/configs/hal_key_config.json 的 Cherry-3566_V0 节：
#   home_key_id=platform-adc-keys-event  home_key_code=115
#   power_key_id=platform-fdd40000.i2c-platform-rk805-pwrkey-event  power_key_code=116
#   head_key_id=platform-led_control-event  head_key_code=134
# 这一节没有音量键与播放键，所以 VOL_* 留空（控制台那两颗键因此不亮）。
MODEL='Rockchip RK3566 Youdao CHERRY Board'
VM_KEY_DEVICE=adc-keys
VM_KEY_BYPATH=platform-adc-keys-event
VM_KEY_CODES=115
HOME_CODE=115
VOL_DOWN_CODE=
VOL_UP_CODE=
