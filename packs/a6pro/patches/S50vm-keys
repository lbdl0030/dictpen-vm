#!/bin/sh
# Runs after S01systeminit started the first app (which initializes the display
# with the QEMU model). Then set the vendor model + start the key helper and
# restart the app so its HAL key modules read the model. Doing this before the
# first app makes x5/a6/a7 render black.
[ "$1" = start ] || exit 0
LOG=/userdata/applog
i=0
while ! ps | grep -q '[m]iniapp' && [ $i -lt 90 ]; do
    sleep 1; i=$((i+1))
done
[ $i -lt 90 ] || exit 0
sleep 8
/usr/bin/vm-keys-apply
# 先停守护链，避免它随后又拉起第二个 app（a7pro 实测重复两个 miniapp）
for p in $(ps | awk '/[r]unDictPen/ {print $1}'); do kill -9 $p 2>/dev/null; done
killall -9 miniapp 2>/dev/null
sleep 1
cd /oem/YoudaoDictPen/output
LD_LIBRARY_PATH=/oem/YoudaoDictPen/output/libs:/etc/miniapp/jsapis:/etc/miniapp/messageknife setsid /usr/bin/miniapp >/userdata/applog/vm-miniapp.log 2>&1 < /dev/null &
echo "vm-keys: delayed apply + app restart done" >>$LOG/vm-keys.log
