#!/bin/sh
# x6pro UI stack: our software compositor + the firmware's own app.
[ "$1" = start ] || exit 0

LOG=/userdata/applog
mkdir -p $LOG /userdata/cfg /userdisk/miniapp/data/mini_app/pkg /userdisk/corefile 2>/dev/null
[ -f /userdata/cfg/debug.cfg ] || cp /etc/debug.cfg /userdata/cfg/debug.cfg 2>/dev/null

# 存储页（Q98）：真机的 S21mountall 会建 /dev/block/by-name；VM 停用它后，
# 设置里的 getStorageInfo 找不到 userdata/userdisk/system_a/b 会回 -1。
# 数据盘是 vdb（userdata/userdisk 共用），系统盘是 vda。
mkdir -p /dev/block/by-name
ln -sf /dev/vdb /dev/block/by-name/userdata
ln -sf /dev/vdb /dev/block/by-name/userdisk
ln -sf /dev/vda /dev/block/by-name/system_a
ln -sf /dev/vda /dev/block/by-name/system_b

# 板型（Q89）：厂商 HAL 的 youdao_get_pcba_version() 读 /proc/device-tree/model，
# 拿固定字符串表映射成 hal_key_config.json 的节名。QEMU 给的是 linux,dummy-virt，
# 映射成 unkown_V? → 所有按键模块 init 失败 -14。内核不让写 model，用 bind mount
# 换成真机名；必须在 app 起来之前生效。表里 x6pro 的原文来自 libydhal_base.so。
MODEL='Rockchip RK3562 MELON LP4 V10 Board'
printf '%s' "$MODEL" > /tmp/dt-model
if [ "$(cat /proc/device-tree/model 2>/dev/null)" != "$MODEL" ]; then
    mount --bind /tmp/dt-model /proc/device-tree/model 2>>$LOG/fake-keys.log
fi

# 实体按键（Q87/Q88/Q89）：真机是 adc-keys；VM 里没有，用 uinput 替身造出
# /dev/input/by-path/platform-adc-keys-event —— hal_key_config.json 的
# RK3562_Melon_V0 节按这个 by-path 名找 home/音量键。必须在 app 起来之前建好。
if [ -x /usr/bin/perl ] && [ -f /usr/bin/fake-keys.pl ]; then
    nohup /usr/bin/perl /usr/bin/fake-keys.pl >$LOG/fake-keys.log 2>&1 &
fi
# HAL 在 app 起来的那一刻就 open() 这条路径 —— 节点没建好它就连不上（实测 m_homeModule -14）。
# 等节点真的出现再往下走，最多等 5 s。
i=0
while [ ! -e /dev/input/by-path/platform-adc-keys-event ] && [ $i -lt 50 ]; do
    sleep 1; i=$((i+1))   # busybox 的 sleep 只认整数（0.1 直接报错，循环会空转）
done
echo "fake-keys wait: $([ -e /dev/input/by-path/platform-adc-keys-event ] && echo ready || echo MISSING) after ${i}s" >>$LOG/fake-keys.log

# Preset mini-app packages: the app expects <pkg>/<id>/a/ with a libs/ subdir.
if [ ! -e /userdisk/miniapp/.pkgs-installed ]; then
    for f in /etc/miniapp/resources/presetpkgs/*.amr; do
        [ -f "$f" ] || continue
        id=$(basename "$f" .amr)
        d=/userdisk/miniapp/data/mini_app/pkg/$id
        mkdir -p "$d/a/libs"
        unzip -o -q "$f" -d "$d/a" >/dev/null 2>&1
    done
    touch /userdisk/miniapp/.pkgs-installed
fi

# Desktop/home mini-app resources shipped with the pack (page bundles + images).
# The id is the one this firmware asks for at runtime (see applog).
if [ -f /userdata/desktop.tar ] && [ ! -e /userdisk/miniapp/.desktop-installed ]; then
    for pid in 8001661999525016 8080222437664451 8080252464522508; do
        D=/userdisk/miniapp/data/mini_app/pkg/$pid/a
        mkdir -p "$D/libs"
        tar xf /userdata/desktop.tar -C "$D"
    done
    touch /userdisk/miniapp/.desktop-installed
fi

# Compositor payload shipped in the pack (installed once, then reused).
if [ ! -x /userdata/debweston/usr/bin/weston ] && [ -f /userdata/weston.tar ]; then
    mkdir -p /userdata/debweston
    tar xf /userdata/weston.tar -C /userdata/debweston && rm -f /userdata/weston.tar
fi
if [ ! -e /usr/lib/aarch64-linux-gnu/libweston-10/drm-backend.so ] && [ -d /userdata/debweston/usr/lib/aarch64-linux-gnu/libweston-10 ]; then
    mkdir -p /usr/lib/aarch64-linux-gnu
    cp -a /userdata/debweston/usr/lib/aarch64-linux-gnu/libweston-10 /usr/lib/aarch64-linux-gnu/
    cp -a /userdata/debweston/usr/lib/aarch64-linux-gnu/weston /usr/lib/aarch64-linux-gnu/
fi
chmod -R 755 /userdata/debweston/usr/bin /userdata/debweston/usr/lib /userdata/debweston/lib 2>/dev/null

export XDG_RUNTIME_DIR=/run/debweston
mkdir -p "$XDG_RUNTIME_DIR" && chmod 700 "$XDG_RUNTIME_DIR"

# Compositor runs with its own library set; the app must never inherit it.
# Guard on the process, not the socket: /run is on the persistent overlay, so a
# hard power-off leaves wayland-0 behind and the old `-S` test skipped weston
# forever -- the app then aborted in greenui::NativeWindow::create() on every
# restart. A stale socket cannot be connected to, so clear it before launching.
if ! pidof weston >/dev/null 2>&1; then
    rm -f "$XDG_RUNTIME_DIR/wayland-0" "$XDG_RUNTIME_DIR/wayland-0.lock"
    ( LD_LIBRARY_PATH=/userdata/debweston/usr/lib/aarch64-linux-gnu:/userdata/debweston/lib/aarch64-linux-gnu \
      exec /userdata/debweston/usr/bin/weston --backend=drm-backend.so --use-pixman \
           --shell=kiosk-shell.so --tty=1 --socket=wayland-0 --idle-time=0 \
           --log=$LOG/vm-weston.log ) >/dev/null 2>&1 &
    n=0
    while [ ! -S "$XDG_RUNTIME_DIR/wayland-0" ] && [ $n -lt 60 ]; do
        n=$((n + 1))
        sleep 1
    done
fi

export WAYLAND_DISPLAY=wayland-0
export LD_LIBRARY_PATH=/oem/YoudaoDictPen/output/libs:/etc/miniapp/jsapis:/etc/miniapp/messageknife
cd /oem/YoudaoDictPen/output || exit 1

# The firmware's own launcher exports zh_CN and supervises the app; match it.
export LC_ALL=zh_CN.utf8
export LANG=zh_CN.utf8
export ALSA_LIB_ADD_GAIN=1
/usr/bin/runSysconfigMgr >$LOG/vm-sysconfig.log 2>&1 &
sleep 2
setsid /usr/bin/guardian_run /usr/bin/miniapp >$LOG/vm-miniapp.log 2>&1 < /dev/null &
echo "x6pro: compositor + firmware app launched"
exit 0