# ===== 不进版本库的东西 =====
# Windows 保留名：某些脚本把 `> NUL` 当成空设备，在 Git Bash/PowerShell 下会真的
# 建出一个叫 NUL 的文件，git index 遇到它会直接报 "NUL: failed to insert into database"
/NUL

# 运行期产物：每次开机会变（状态盘、日志、截屏、pid、vmgui 输出…）
vm/

# 外部依赖：用 scripts/bootstrap.py 或按 README《重建环境》自行获取
tools/msys2/
tools/pkgs/
tools/db/
tools/*.db
tools/zstd/
tools/kernel-root/
tools/kernel-root-gui/
tools/busybox-root/
tools/arm64-rootfs/
tools/platform-tools/

# 本机生成、不该外传的：SSH 私钥、自签证书
tools/ssh/
vm/mitm/*.pem

# 固件镜像（版权归网易有道，需自行下载；见 README《分发与重建》）
# 它们放在固件包里：packs/<名字>/images/
downloads/*.img
downloads/*.deb
downloads/arm64/
packs/*/images/
# 从客机拉出来分析的预设应用包（`.amr` 同属有道派生的二进制，只做本地取证用）
/amrs/
# 整包快照（几百 MB ~ 1.6 GB，属于分发产物，不进版本库）
packs/*.zip
dist/*.zip

# 构建产物
images/initramfs.cpio.gz
dist/

# 根目录的本机取证残留（只锚定根目录，**不误伤 packs/*/patches/*.so** —— 那是包要用的补丁库）
# /libydhal_devices.so 是 a7pro 的**原始厂商库**（md5 1324f231…，见 packs/a7pro/README.md
# 的"原始来源"那行），派生 .so 靠它重新生成，所以留在盘上、但不进版本库。
/guest
/_get_uuid.bin
/libydhal_devices.so

# Python
__pycache__/
*.pyc